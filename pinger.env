# Пример значений для демонстрации. Логин и пароль должны совпадать
# с APP_DB_USER / APP_DB_PASSWORD из .env базы. Интервал по заданию 5 минут;
# для показа его задают при запуске: -e PING_INTERVAL_SECONDS=10.
PING_INTERVAL_SECONDS=300
DB_USER=app_user
DB_PASSWORD=change_me_app
LOG_FILE=/logs/pinger.log
